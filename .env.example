# Maestro AI Executive Assistant - Configuration Template
# Copy this file to .env and add your actual values

# =============================================================================
# API Keys for LLM Services
# =============================================================================

# Anthropic API Key (get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API Key (get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# Google Gemini API Key (if different from GOOGLE_API_KEY)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# LLM Scorecard Configuration (Legacy)
# =============================================================================

# Optional Configuration (can also be set via command-line args)
# Number of prompts to generate per task type
NUM_PROMPTS=1

# Number of times to run each prompt
RUNS_PER_PROMPT=1

# =============================================================================
# Maestro Phase 1 Configuration - Local RAG
# =============================================================================

# === Database ===
POSTGRES_USER=maestro
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=maestro
DATABASE_URL=postgresql://maestro:change_me_in_production@postgres:5432/maestro

# === Ollama (Local LLM) ===
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_GPU_ENABLED=false
OLLAMA_NUM_GPU=0

# === Google Cloud (Phase 2) ===
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-credentials.json
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# === Open WebUI ===
WEBUI_SECRET_KEY=generate-a-random-secret-key
WEBUI_PORT=3000

# === Maestro Backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# === Security ===
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
JWT_SECRET=generate-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# === Path Mapping Service ===
OBSIDIAN_VAULT_PATH=/app/data/vault
GDRIVE_SYNC_PATH=/app/data/gdrive-sync

# === Feature Flags ===
ENABLE_PROACTIVE_SUGGESTIONS=true
ENABLE_HITL_CONFIRMATIONS=true
ENABLE_USER_BEHAVIOR_MODELING=false
