rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sessions collection - restrict access to authenticated service accounts
    match /sessions/{sessionId} {
      // Allow service account to read/write
      // In production, you should add more specific authentication rules
      allow read, write: if request.auth != null;

      // For development/testing - remove this in production
      // allow read, write: if true;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
