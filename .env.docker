# ==============================================
# Maestro Docker Swarm Environment Configuration
# ==============================================
# Copy this file to .env and fill in your actual values

# ==============================================
# API Keys (Required)
# ==============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================
# Evaluation Service Configuration
# ==============================================
NUM_PROMPTS=1
RUNS_PER_PROMPT=1

# ==============================================
# Local RAG Agent Configuration
# ==============================================
# Path to your Obsidian vault on the host machine
# This will be mounted as read-only into the container
OBSIDIAN_VAULT_PATH=/vault
VAULT_HOST_PATH=./data/vault

# ==============================================
# Path Mapping Service Configuration
# ==============================================
MAPPINGS_FILE=/app/data/path_mappings.json

# ==============================================
# Service URLs (Internal Docker Network)
# ==============================================
# These are used by the supervisor to communicate with other services
LOCAL_RAG_URL=http://local-rag:8001
PATH_MAPPING_URL=http://path-mapping:8002
SKILLS_URL=http://skills:8004

# ==============================================
# Docker Swarm Configuration
# ==============================================
# Stack name for deployment
STACK_NAME=maestro

# ==============================================
# Optional: External Services
# ==============================================
# If you have external Ollama instance
# OLLAMA_URL=http://host.docker.internal:11434

# If you have external Redis/PostgreSQL
# REDIS_URL=redis://redis:6379
# DATABASE_URL=postgresql://user:pass@postgres:5432/maestro
