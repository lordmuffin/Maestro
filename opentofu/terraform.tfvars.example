# V2V2B Interrogator - Azure Terraform Variables
# Copy this file to terraform.tfvars and update with your values

# Azure Configuration
azure_subscription_id = "your-subscription-id"
location              = "eastus"
environment           = "staging"

# GitHub Integration
github_tokens = {
  maestro = "ghp_your_maestro_token"
  beyond  = "ghp_your_beyond_token"
}

# Bot Configuration
telegram_bot_token = "your-bot-token"

# Optional: Naming overrides
# resource_group_name  = "my-rg"
# function_name        = "my-function"
# storage_account_name = "mystorage"
# cosmos_db_name       = "mycosmos"

# Drive Integration (Folder IDs)
google_drive_folder_id   = ""
obsidian_drive_folder_id = ""
kanban_folder_id         = ""
